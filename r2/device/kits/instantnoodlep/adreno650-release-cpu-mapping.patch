+/* The shared A650 ring advances completedFence only after observing its
+ * hardware fence word. Attribute the first sampled fence to its own client. */
+void AGXDeviceUserClient::noteMetalFenceLocked(uint32_t method, IOReturn status,
+    const void *output, size_t outputSize)
+{
+    if (kernel_ || closing_ || firstMetalFenceDone_) return;
+    if (!firstMetalFence_) {
+        if (method != NativeAdrenoMethodSubmit || status || !output ||
+            outputSize != sizeof(NativeAdrenoAbiSubmitReply)) return;
+        if (strcmp(name_, "backboardd") && strcmp(name_, "CollectionsPoster") &&
+            strcmp(name_, "AegirPoster") && strcmp(name_, "Preferences") &&
+            strcmp(name_, "iconservicesagent")) return;
+        NativeAdrenoAbiSubmitReply reply{};
+        memcpy(&reply, output, sizeof(reply));
+        firstMetalFence_=static_cast<uint32_t>(reply.fence);
+        if (!firstMetalFence_) return;
+        printf("METAL69 submit process=%s fence=%u\n", name_, firstMetalFence_);
+    }
+    if (!g.ring || g.ring->poisoned()) return;
+    const uint32_t completed=g.ring->completedFence();
+    if (completed < firstMetalFence_) return;
+    firstMetalFenceDone_=true;
+    printf("METAL69 complete process=%s fence=%u hw_completed=%u\n",
+        name_, firstMetalFence_, completed);
+}
