+/* A telemetry row is complete when the same writer starts its next row.
+ * Keep one completed draw sample per table alongside the aggregate counters. */
+static void logMetalTelemetryRow(const char *line, bool &reportedDraw)
+{
+    bool draw=false;
+    if (!reportedDraw && line[0]=='K' && line[1]>='0' && line[1]<='9') {
+        bool encodedDraw=false, completed=false;
+        for (const char *field=line; *field; ++field) {
+            if (!strncmp(field," dr",3)) encodedDraw=field[3]>='1' && field[3]<='9';
+            if (!strncmp(field," ctc=",5)) completed=field[5]>='1' && field[5]<='9';
+        }
+        draw=encodedDraw && completed;
+    }
+    if (!draw && strncmp(line,"S c",3) && strncmp(line,"V vkpipe ",9) &&
+        strncmp(line,"J completed wait ",17) && strncmp(line,"J resource wait ",16) &&
+        strncmp(line,"PR compiling=",13) && strncmp(line,"T pipeline ",11) &&
+        strncmp(line,"T library ",10)) return;
+    for (const char *c=line; *c; ++c) if (*c<' ' || *c>'~') return;
+    char who[20]={};
+    proc_selfname(who,sizeof who);
+    if (strcmp(who,"backboardd")) return;
+    if (draw) reportedDraw=true;
+    printf("METAL70 backboardd pid=%d %s\n",proc_selfpid(),line);
+}
