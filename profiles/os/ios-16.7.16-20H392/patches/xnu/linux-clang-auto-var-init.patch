# New for xnu-8796 (the 10063 train already dropped this flag): clang 18+ removed
# -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang; the modern
# -ftrivial-auto-var-init=zero on the line above already provides the zero-init behavior.
# Without this, Xcode 26 / LLVM 18+ clangs fail every CFLAGS_GEN compile (first seen at
# the iokit .iig.cpo rules on CI run 44042865569).
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -306,7 +306,6 @@ CFLAGS_GEN = $(DEBUG_CFLAGS) -nostdinc \
 	-fno-builtin \
 	-fno-common \
 	-ftrivial-auto-var-init=zero \
-	-enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang \
 	-fsigned-bitfields \
 	-fmerge-all-constants \
 	-fno-c++-static-destructors \
