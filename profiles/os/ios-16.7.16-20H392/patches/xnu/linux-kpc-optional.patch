# xnu-8796 OSS release omits osfmk/arm64/kpc.c (arm64 KPC implementation).
# files.arm64 lists it as "optional kpc nos_arm_asm" (OR semantics); our config
# enables nos_arm_asm, pulling the missing file into the build. KPC is a diagnostic
# feature and CONFIG_KPC is off, so gate the file on kpc alone.
--- a/osfmk/conf/files.arm64
+++ b/osfmk/conf/files.arm64
@@ -91,7 +91,7 @@
 
 # Kernel performance monitoring
 osfmk/arm64/perfmon_arm64.c optional config_perfmon
-osfmk/arm64/kpc.c		optional kpc nos_arm_asm
+osfmk/arm64/kpc.c		optional kpc
 osfmk/arm64/monotonic_arm64.c optional monotonic
 
 osfmk/arm64/platform_tests.c			optional config_xnupost
